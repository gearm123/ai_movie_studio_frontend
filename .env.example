# Local dev — leave VITE_API_BASE_URL empty; Vite proxies /api and /health to the backend
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Production (Netlify) — also set in netlify.toml [build.environment]
# VITE_API_BASE_URL=https://ai-movie-studio-backend.onrender.com

# Same value as BACKEND_API_KEY on Render (leave empty if backend auth is disabled locally)
# VITE_BACKEND_API_KEY=

# Local dev — Vite proxies /api and /health to this target
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Production — set when deploying the static site (e.g. Render static site or Netlify)
# VITE_API_BASE_URL=https://your-backend.onrender.com

# Optional — sent as X-API-Key when calling the backend (future steps)
# VITE_BACKEND_API_KEY=

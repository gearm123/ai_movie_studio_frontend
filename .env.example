# Local dev — direct API URL (same pattern as translate-chat-frontend)
VITE_API_BASE_URL=https://ai-history-backend.onrender.com
VITE_BACKEND_API_KEY=

# Or proxy to local backend on :8000 (leave VITE_API_BASE_URL empty + vite proxy)
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Production (Netlify) — also in netlify.toml [build.environment]
# Use ai-history-backend.onrender.com (not ai-history-api — browsers block “-api” hostnames)
# Render: CORS_ORIGINS=https://gearmstudio.netlify.app
# Netlify: VITE_BACKEND_API_KEY = Render API_KEY (not Gemini key)

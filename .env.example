# --- Local dev (npm run dev) ---
# Option A: talk to Render directly
VITE_API_BASE_URL=https://ai-history-api.onrender.com
VITE_BACKEND_API_KEY=

# Option B: proxy to local backend — leave VITE_API_BASE_URL empty, start API on :8000
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# --- Production (Netlify) — also set in netlify.toml [build.environment] ---
# VITE_API_BASE_URL=https://ai-history-api.onrender.com
# VITE_BACKEND_API_KEY=  (same as API_KEY on Render — NOT your Gemini key)

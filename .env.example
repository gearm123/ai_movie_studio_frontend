# Local dev — leave VITE_API_BASE_URL empty; Vite proxies /api and /health to the backend
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Production (Netlify) — leave VITE_API_BASE_URL unset; netlify.toml proxies /api and /health to Render
# Only set this if you bypass the Netlify proxy (then configure CORS_ORIGINS on Render):
# VITE_API_BASE_URL=https://your-service.onrender.com

# Same value as BACKEND_API_KEY on Render (leave empty if backend auth is disabled locally)
# VITE_BACKEND_API_KEY=
